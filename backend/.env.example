# Comma-separated browser origins allowed to call the API (production frontend).
# Example: https://your-app.vercel.app
CORS_ORIGINS=

# Persistent data root for uploads, storage/, logs/ (Railway volume or Render disk).
# Leave unset locally — defaults to the monorepo root.
# DATA_DIR=/var/data

# Optional PDF/OCR tuning
# PDF_PROCESS_WORKERS=4
# OCR_RENDER_SCALE=2.5

# --- RMA Request Portal: email notifications ---
# Gmail SMTP via an App Password (requires 2-Step Verification on the Gmail
# account): https://myaccount.google.com/apppasswords
# Leave SMTP_HOST blank to disable notification emails (submissions still work).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true
# Comma-separated list of internal addresses to notify on new submissions
REQUEST_NOTIFY_RECIPIENTS=
# Frontend origin, used to build the "view request" link in the notification email
# e.g. https://your-app.vercel.app or your Cloudflare tunnel URL
PORTAL_BASE_URL=
