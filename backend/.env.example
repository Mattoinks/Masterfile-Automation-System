# Comma-separated browser origins allowed to call the API (production frontend).
# Example: https://your-app.vercel.app
CORS_ORIGINS=

# Persistent data root for uploads, storage/, logs/ (Railway volume or Render disk).
# Leave unset locally — defaults to the monorepo root.
# DATA_DIR=/var/data

# Optional PDF/OCR tuning
# PDF_PROCESS_WORKERS=4
# OCR_RENDER_SCALE=2.5
