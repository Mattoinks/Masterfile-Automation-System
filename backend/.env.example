# Comma-separated browser origins allowed to call the API (production frontend).
# Example: https://your-app.vercel.app
CORS_ORIGINS=

# Persistent data root for uploads, storage/, logs/ (Railway volume or Render disk).
# Leave unset locally — defaults to the monorepo root.
# DATA_DIR=/var/data

# Optional PDF/OCR tuning
# PDF_PROCESS_WORKERS=4
# OCR_RENDER_SCALE=2.5

# --- RMA Request Portal: email notifications ---
# Gmail SMTP via an App Password (requires 2-Step Verification on the Gmail
# account): https://myaccount.google.com/apppasswords
# Leave SMTP_HOST blank to disable notification emails (submissions still work).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true
# Comma-separated list of internal addresses to notify on new submissions
REQUEST_NOTIFY_RECIPIENTS=
# Frontend origin, used to build the "view request" link in the notification email
# e.g. https://your-app.vercel.app or your Cloudflare tunnel URL
PORTAL_BASE_URL=

# --- Gemini API (AI-based PDF extraction, optional) ---
# Leave blank to use the existing regex/OCR extraction pipeline only.
# Free tier only. Only ever attempted for scanned/image PDFs - native-text
# PDFs always use the fast local extractor regardless of this setting.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# Hard rollout gate - do NOT set to true until you've run
# backend/scripts/benchmark_gemini_extraction.py against real scanned DN
# PDFs from this project and confirmed Gemini is worth using for them. Even
# with a valid GEMINI_API_KEY above, Gemini is not used for real processing
# while this is false/unset - it only runs when the benchmark script calls
# it directly.
# GEMINI_SCANNED_PDF_ENABLED=false

# --- Supabase Postgres (see supabase/README.md) ---
# Two different roles/pooling modes - see supabase/migrations/0001_initial_schema.sql
# for why there are two. Both required once app/services/db.py is in use.
SUPABASE_DB_URL=
SUPABASE_DB_URL_BYPASS=
