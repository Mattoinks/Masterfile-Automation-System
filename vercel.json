{
    "version": 2,
    "services": {
      "frontend": {
        "root": "frontend",
        "framework": "vite"
      },
      "backend": {
        "root": "backend",
        "framework": "python" 
      }
    },
    "rewrites": [
      {
        "source": "/api/(.*)",
        "destination": "/backend/$1"
      },
      {
        "source": "/(.*)",
        "destination": "/frontend/$1"
      }
    ]
  }