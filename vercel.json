{
    "version": 2,
    "services": {
      "frontend": {
        "root": "frontend/",
        "framework": "vite"
      },
      "backend": {
        "root": "backend/",
        "framework": "python"
      }
    },
    "rewrites": [
      {
        "source": "/api/(.*)",
        "destination": { "service": "backend" }
      },
      {
        "source": "/(.*)",
        "destination": { "service": "frontend" }
      }
    ]
  }