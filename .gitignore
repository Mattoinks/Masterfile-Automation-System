# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/

# Node
node_modules/
frontend/dist/
frontend/dist-ssr/
backend/static/
*.local

# Runtime data (created dynamically; do not deploy)
uploads/**
!uploads/.gitkeep
processed/**
!processed/.gitkeep
logs/**
!logs/.gitkeep
analyze/**
!analyze/.gitkeep

# Storage: keep folder structure, ignore runtime files
storage/masterfile/*.xlsx
storage/masterfile/*.xls
!storage/masterfile/.gitkeep
storage/index/*.db
!storage/index/.gitkeep
storage/backup/**
!storage/backup/.gitkeep
storage/ocr_cache/**
!storage/ocr_cache/.gitkeep

# Packaged seed template ships with the API (needed for empty DATA_DIR boots)
!backend/assets/
!backend/assets/master-template.xlsx

# Samples & local analysis artifacts
samples/**/*.pdf
samples/**/*.png

# Secrets
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
backend/.env
backend/.env.*
!backend/.env.example

# IDE / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Misc
*.log
*.tmp
*.bak

# Downloaded local tools (not project source)
cloudflared.exe
